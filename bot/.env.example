# Telegram Bot API token, from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Base URL of the Backup Orchestrator API this bot talks to.
BOT_API_BASE_URL=http://localhost:8000

# Fernet key used to encrypt/decrypt the locally-cached bearer tokens
# (bot/crypto.py, bot/auth_store.py). Should match the API server's own
# FERNET_KEY (see root .env.example). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# How often (seconds) the background alert-poller checks for new alerts.
BOT_ALERT_POLL_INTERVAL_SECONDS=60

# Per-request HTTP timeout (seconds) for calls to the Backup Orchestrator API.
BOT_HTTP_TIMEOUT_SECONDS=15.0

# Local sqlite file backing bot/auth_store.py (linked users + alert-poll
# high-water-mark). Needs the same operational care (backups, filesystem
# permissions) as the API's own database file.
BOT_STATE_DB_PATH=./bot_state.db

# How long (seconds) a pending /restore confirmation stays valid.
BOT_RESTORE_CONFIRMATION_TTL_SECONDS=300

# How many mismatched /restore confirmation replies are tolerated before
# the pending restore is auto-cancelled.
BOT_RESTORE_CONFIRMATION_MAX_ATTEMPTS=3

# Optional comma-separated allowlist of Telegram chat ids permitted to use
# this bot at all, e.g. "123456789,-100987654321". Leave unset (default)
# to allow every chat.
BOT_ALLOWED_CHAT_IDS=

BOT_LOG_LEVEL=INFO
