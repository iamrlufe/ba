DATABASE_URL=sqlite+aiosqlite:///./backup_orchestrator.db
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
SQL_ECHO=false

# JWT signing secret (HS256). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Bootstrap admin, consumed once at startup. Both must be set together, or
# both left unset.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Shared secret agents/schedulers present via the X-Agent-Key header to call
# agent-driven endpoints. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# SEPARATE shared secret (do NOT reuse AGENT_API_KEY) presented via the
# X-Connection-Config-Key header to call
# GET /api/agents/{server_id}/connection-config, which returns DECRYPTED
# FTP/SFTP credentials. See the prominent warning in CLAUDE.md: single
# global secret, no per-server scoping yet -- do not use with real
# production credentials until per-server agent keys are implemented, and
# restrict this endpoint to the VPN perimeter at the network level.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CONNECTION_CONFIG_API_KEY=

# Background alert-detection worker (app/workers/alert_worker.py).
ALERT_WORKER_TICK_INTERVAL_SECONDS=300
ALERT_WORKER_ENABLED=true
AGENT_OFFLINE_THRESHOLD_MINUTES=10
DAILY_SUMMARY_HOUR_UTC=8
DAILY_SUMMARY_MINUTE_UTC=0

# Lifetime (minutes) of a bot-scoped JWT minted by POST /api/auth/telegram-link.
# Long-lived by design (default 30 days) -- see app/core/config.py.
BOT_TOKEN_EXPIRE_MINUTES=43200

# Backup verification (app/workers/backup_verification.py).
BACKUP_VERIFICATION_ENABLED=true
BACKUP_VERIFICATION_INTERVAL_SECONDS=86400
BACKUP_VERIFICATION_CONNECT_TIMEOUT_SECONDS=30
BACKUP_VERIFICATION_RESTORE_TIMEOUT_SECONDS=1800
BACKUP_VERIFICATION_STUCK_RUN_GRACE_SECONDS=900
