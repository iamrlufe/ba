DATABASE_URL=sqlite+aiosqlite:///./backup_orchestrator.db
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
SQL_ECHO=false

# JWT signing secret (HS256). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Bootstrap admin, consumed once at startup. Both must be set together, or
# both left unset.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Shared secret agents/schedulers present via the X-Agent-Key header to call
# agent-driven endpoints. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=
